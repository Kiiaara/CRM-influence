# Telegram бот: токен для Login Widget и для отправки уведомлений
AUTH_BOT_TOKEN=
AUTH_BOT_USERNAME=
# Через запятую - TG ID первых админов (упадут в whitelist при первом старте)
AUTH_ALLOWED_TG_IDS=

# Подпись cookie сессии (минимум 32 символа)
SESSION_SECRET=change-me-to-long-random-string

# БД
DATABASE_URL=sqlite:///./data/zametochnitsa.db

# Куда фронт коннектится (для CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Публичный URL приложения (для ссылок в TG-уведомлениях)
PUBLIC_URL=http://localhost:5173

# Периодичность проверки дедлайнов (сек)
SCHEDULER_INTERVAL_SECONDS=60
BLOGGERS_SYNC_MINUTES=30  # автообновление базы блогеров из гугл-таблицы (0 - только вручную)
SITE_GITHUB_TOKEN=       # публикация кейсов на сайт: fine-grained токен GitHub, Contents: Read and write на Kiiaara/site
# Автоперевод кейсов на EN/ZH. Основной - DeepL: ключ бесплатный (500 тыс. символов в месяц), deepl.com/pro-api.
# Ключ Free заканчивается на :fx, адрес API выбирается по нему сам. Groq с FirstVDS заблокирован (403), см. ниже
DEEPL_API_KEY=
# Какой переводчик использовать: auto (DeepL, если задан ключ, иначе Groq), deepl или groq. Пусто - auto
TRANSLATE_PROVIDER=
GROQ_API_KEY=            # запасной переводчик кейсов на EN/ZH, бесплатно: console.groq.com -> API Keys
GROQ_MODEL=llama-3.3-70b-versatile
# Адрес Groq. Если Groq отвечает 403 (блокирует IP сервера) - укажи URL своего Cloudflare Worker-прокси
# (без слэша на конце, см. CLOUDFLARE_WORKER_SETUP.md). Пусто или не задано - напрямую api.groq.com
GROQ_API_BASE=
