# Telegram бот: токен для Login Widget и для отправки уведомлений
AUTH_BOT_TOKEN=
AUTH_BOT_USERNAME=
# Через запятую - TG ID первых админов (упадут в whitelist при первом старте)
AUTH_ALLOWED_TG_IDS=

# Подпись cookie сессии (минимум 32 символа)
SESSION_SECRET=change-me-to-long-random-string

# БД
DATABASE_URL=sqlite:///./data/zametochnitsa.db

# Куда фронт коннектится (для CORS)
FRONTEND_ORIGIN=http://localhost:5173

# Публичный URL приложения (для ссылок в TG-уведомлениях)
PUBLIC_URL=http://localhost:5173

# Периодичность проверки дедлайнов (сек)
SCHEDULER_INTERVAL_SECONDS=60
BLOGGERS_SYNC_MINUTES=30  # автообновление базы блогеров из гугл-таблицы (0 - только вручную)
SITE_GITHUB_TOKEN=       # публикация кейсов на сайт: fine-grained токен GitHub, Contents: Read and write на Kiiaara/site
ANTHROPIC_API_KEY=       # автоперевод кейсов на EN/ZH (console.anthropic.com)
